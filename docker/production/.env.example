# Production environment for the tasks-app and tasks-celery containers.
# Copy to $DEPLOY_PATH/.env on the server; the deploy passes it via --env-file.
# Containers run with --network host, so 127.0.0.1 is the host itself.
#
# --env-file takes values literally: no quotes, no variable expansion.

SECRET_KEY=change-me

# Postgres needs password auth over TCP (the container can't use peer auth
# through the host's unix socket). URL-encode special characters.
DATABASE_URL=postgres://tasks:password@127.0.0.1:5432/tasks

# smtp:// for plain SMTP, smtp+tls:// for STARTTLS, smtp+ssl:// for SMTPS
EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=tasks@example.com
SERVER_EMAIL=tasks@example.com

CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Optional; defaults to tasks.polybrain.org and localhost
# ALLOWED_HOSTS=tasks.polybrain.org,localhost

# Trip photos (AWS S3). Leave the endpoint URLs unset for real AWS S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_BUCKET=tasks-trip-photos

# Optional gunicorn tuning
# GUNICORN_WORKERS=5
# LOG_LEVEL=info
